{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNEXT"
  },
  "//": "Tests are checked by tsconfig.test.json instead: they import with the `.ts` extension node needs, which this config cannot allow while webpack emits through it.",
  "exclude": [
    "**/node_modules",
    "_site",
    "**/*.test.ts"
  ]
}
